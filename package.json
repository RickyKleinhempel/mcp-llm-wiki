{
  "name": "mcp-llm-wiki",
  "version": "0.1.1",
  "type": "module",
  "description": "MCP server for an LLM-owned wiki with hybrid BM25 + local CPU vector search",
  "license": "MIT",
  "author": "Ricky Kleinhempel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickyKleinhempel/mcp-llm-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/RickyKleinhempel/mcp-llm-wiki/issues"
  },
  "homepage": "https://github.com/RickyKleinhempel/mcp-llm-wiki#readme",
  "bin": {
    "mcp-llm-wiki": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "node test/unit.mjs && node test/smoke.mjs",
    "test:unit": "node test/unit.mjs",
    "test:stdio": "node test/stdio.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "sqlite-vec": "^0.1.7-alpha.2",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
